{
  "name": "@drumee/infra-layer",
  "version": "0.1.0-alpha.3",
  "private": false,
  "description": "Docker infrastructure planning, secret projections, isolated application composition and lifecycle recovery.",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drumee/infra-layer.git"
  },
  "homepage": "https://github.com/drumee/infra-layer#readme",
  "bugs": {
    "url": "https://github.com/drumee/infra-layer/issues"
  },
  "files": [
    "lib/",
    "capabilities/",
    "adapters/",
    "lifecycle/",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "PROVENANCE.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node test/all-integration.js",
    "test:package": "node test/package-audit.js",
    "test:gateway": "node test/integration/run.js",
    "test:services": "node test/services/run.js",
    "test:lifecycle": "node test/lifecycle/run.js",
    "test:lifecycle:gateway": "node test/lifecycle/gateway-run.js",
    "test:application": "node test/application/run.js",
    "lint": "node tooling/lint.cjs",
    "test:contracts": "node --test test/unit/application-contract.test.js test/unit/composition.test.js test/unit/distribution-isolation.test.js"
  },
  "devDependencies": {
    "@drumee/server-runtime": "0.1.0-alpha.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsonfile": "6.2.1",
    "lodash": "4.18.1",
    "mariadb": "3.5.4",
    "nodemailer": "10.1.1",
    "redis": "4.7.1",
    "smtp-server": "3.19.22",
    "websocket": "1.0.35",
    "yaml": "2.9.1"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./lifecycle": {
      "types": "./lifecycle/index.d.ts",
      "require": "./lifecycle/index.js",
      "default": "./lifecycle/index.js"
    },
    "./lifecycle/*": "./lifecycle/*.js",
    "./lib/*": "./lib/*.js",
    "./adapters/docker/*": "./adapters/docker/*.js",
    "./capabilities/secrets": "./capabilities/secrets/index.js",
    "./capabilities/tls": "./capabilities/tls/index.js",
    "./capabilities/dns": "./capabilities/dns/index.js",
    "./capabilities/database": "./capabilities/database/index.js",
    "./capabilities/redis": "./capabilities/redis/index.js",
    "./capabilities/mail": "./capabilities/mail/index.js",
    "./capabilities/http/nginx": "./capabilities/http/nginx/index.js",
    "./capabilities/tls/acme": "./capabilities/tls/acme.js"
  }
}
